{
  "name": "little-daily",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-notices.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:ui",
    "check:release": "node scripts/check-release.mjs",
    "mobile:sync": "npm run build && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:check": "node scripts/check-mobile.mjs",
    "mobile:release-check": "node scripts/check-mobile.mjs --release",
    "build:verified": "npm test && npm run build && npm run check:release",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "~5.7.3",
    "vite": "^6.0.5",
    "vitest": "^5.0.5"
  }
}
